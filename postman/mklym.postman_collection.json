{
  "info": {
    "name": "mklym API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('status field is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create item",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/items",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"postman item\", \"description\": \"created by newman\"}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('item has id and name', () => {",
              "  pm.expect(body.id).to.be.a('number');",
              "  pm.expect(body.name).to.eql('postman item');",
              "});",
              "pm.collectionVariables.set('itemId', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get item",
      "request": { "method": "GET", "url": "{{baseUrl}}/items/{{itemId}}" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('same item returned', () => pm.expect(pm.response.json().name).to.eql('postman item'));"
            ]
          }
        }
      ]
    },
    {
      "name": "List items",
      "request": { "method": "GET", "url": "{{baseUrl}}/items" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('list contains created item', () => {",
              "  const ids = pm.response.json().map((item) => item.id);",
              "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('itemId')));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete item",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/items/{{itemId}}" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get deleted item",
      "request": { "method": "GET", "url": "{{baseUrl}}/items/{{itemId}}" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}